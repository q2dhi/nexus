<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- PRESSED / SUNKEN STATE (Deep Royal Blue) -->
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:top="0dp"
                android:left="0dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/neomorph_blue_shadow" />
                </shape>
            </item>
            <item
                android:top="1dp"
                android:left="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#172554"
                        android:endColor="@color/nexus_royal_blue" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- DEFAULT EXTRUDED ROYAL BLUE -->
    <item>
        <layer-list>
            <!-- Outer Dark Shadow -->
            <item
                android:top="3dp"
                android:left="3dp"
                android:right="0dp"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/neomorph_shadow_dark" />
                </shape>
            </item>
            <!-- Outer Light Glow -->
            <item
                android:top="0dp"
                android:left="0dp"
                android:right="3dp"
                android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/neomorph_shadow_light" />
                </shape>
            </item>
            <!-- Raised Royal Blue Surface with Top-Left Highlight -->
            <item
                android:top="2dp"
                android:left="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#2563EB"
                        android:endColor="@color/nexus_royal_blue" />
                    <stroke
                        android:width="0.5dp"
                        android:color="#60A5FA" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
