<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- PRESSED / SUNKEN STATE -->
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:top="0dp"
                android:left="0dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/neomorph_inset_dark" />
                </shape>
            </item>
            <item
                android:top="2dp"
                android:left="2dp"
                android:right="0dp"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/neomorph_inset_light" />
                </shape>
            </item>
            <item
                android:top="1dp"
                android:left="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/nexus_surface_subtle" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- DEFAULT / EXTRUDED 3D STATE -->
    <item>
        <layer-list>
            <!-- Bottom-Right Dark Shadow -->
            <item
                android:top="3dp"
                android:left="3dp"
                android:right="0dp"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/neomorph_shadow_dark" />
                </shape>
            </item>
            <!-- Top-Left White Highlight -->
            <item
                android:top="0dp"
                android:left="0dp"
                android:right="3dp"
                android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/neomorph_shadow_light" />
                </shape>
            </item>
            <!-- Raised Surface -->
            <item
                android:top="2dp"
                android:left="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="@color/neomorph_surface_highlight"
                        android:endColor="@color/neomorph_surface" />
                    <stroke
                        android:width="0.5dp"
                        android:color="@color/neomorph_border_bevel" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
