<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom-Right Dark Shadow -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/neomorph_shadow_dark" />
        </shape>
    </item>

    <!-- Top-Left Light Glow -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/neomorph_shadow_light" />
        </shape>
    </item>

    <!-- Pill Surface -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/neomorph_surface_highlight"
                android:endColor="@color/neomorph_surface" />
            <stroke
                android:width="0.5dp"
                android:color="@color/neomorph_border_bevel" />
        </shape>
    </item>
</layer-list>
