<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Top-Left Inset Shadow (Darker shade simulating depth) -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/neomorph_inset_dark" />
        </shape>
    </item>

    <!-- 2. Bottom-Right Inset Highlight (White reflection at bottom) -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/neomorph_inset_light" />
        </shape>
    </item>

    <!-- 3. Sunken Inner Cavity Surface -->
    <item
        android:top="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:angle="135"
                android:startColor="#DFE6F1"
                android:endColor="#EBF0F7" />
        </shape>
    </item>
</layer-list>
