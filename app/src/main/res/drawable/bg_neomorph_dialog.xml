<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Soft Dark Drop Shadow -->
    <item
        android:top="4dp"
        android:left="4dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/neomorph_shadow_dark" />
        </shape>
    </item>

    <!-- 2. Pure White Light Glow -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/neomorph_shadow_light" />
        </shape>
    </item>

    <!-- 3. Raised Neomorphic Dialog Body -->
    <item
        android:top="3dp"
        android:left="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/neomorph_surface_highlight"
                android:endColor="@color/neomorph_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/neomorph_border_bevel" />
        </shape>
    </item>
</layer-list>
