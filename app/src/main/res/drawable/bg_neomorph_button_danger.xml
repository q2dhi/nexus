<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- PRESSED / SUNKEN STATE (Deep Crimson) -->
    <item android:state_pressed="true">
        <layer-list>
            <item
                android:top="0dp"
                android:left="0dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#7F1D1D" />
                </shape>
            </item>
            <item
                android:top="1dp"
                android:left="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#7F1D1D"
                        android:endColor="#991B1B" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- DEFAULT EXTRUDED RED -->
    <item>
        <layer-list>
            <!-- Outer Dark Shadow -->
            <item
                android:top="3dp"
                android:left="3dp"
                android:right="0dp"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/neomorph_shadow_dark" />
                </shape>
            </item>
            <!-- Outer Light Glow -->
            <item
                android:top="0dp"
                android:left="0dp"
                android:right="3dp"
                android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/neomorph_shadow_light" />
                </shape>
            </item>
            <!-- Raised Crimson Surface with Top-Left Highlight -->
            <item
                android:top="2dp"
                android:left="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#EF4444"
                        android:endColor="@color/nexus_red" />
                    <stroke
                        android:width="0.5dp"
                        android:color="#F87171" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
