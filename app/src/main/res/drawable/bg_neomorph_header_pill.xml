<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Inset Shadow in Blue Surface -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#172554" />
        </shape>
    </item>

    <!-- Outer Inset Light Reflection -->
    <item
        android:top="1.5dp"
        android:left="1.5dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#3B82F6" />
        </shape>
    </item>

    <!-- Sunken Dark Blue Body -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <solid android:color="#1E3A8A" />
        </shape>
    </item>
</layer-list>
