<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:background="@drawable/bg_neomorph_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="26dp">

    <!-- Incoming Call Animated Icon -->
    <ImageView
        android:id="@+id/ivCallIcon"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_neomorph_pill"
        android:backgroundTint="#ECFDF5"
        android:padding="16dp"
        android:src="@drawable/ic_nexus_shield"
        app:tint="#059669"
        android:contentDescription="Call Avatar" />

    <TextView
        android:id="@+id/tvCallHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="اتصال صوتي مباشر وارد"
        android:textColor="#059669"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCallerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="إدارة النظام المركزية (Web Admin)"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCallStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="جاري الاتصال بالجهاز... الرنين مستمر"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDeclineCall"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_neomorph_button_danger"
            android:text="رفض / إنهاء"
            android:textColor="#DC2626"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAcceptCall"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_neomorph_button_primary"
            android:text="رد على الاتصال"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
