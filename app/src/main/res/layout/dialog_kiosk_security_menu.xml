<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/nexus_bg_light"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Accent / Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Administrator Security Menu"
            android:textColor="@color/nexus_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXUS"
            android:textColor="@color/nexus_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select authorized maintenance action:"
        android:textColor="@color/nexus_text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <!-- Action 1: Exit to Android OS -->
    <LinearLayout
        android:id="@+id/btnSecurityExitToAndroid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_flat_item"
        android:backgroundTint="#0F172A"
        android:orientation="vertical"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exit to Android OS"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disengage dedicated LockTask and restore system launcher"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Action 2: Admin Console & Settings -->
    <LinearLayout
        android:id="@+id/btnSecurityAdminPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_flat_item"
        android:backgroundTint="#1E293B"
        android:orientation="vertical"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Administrator Console"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server configuration, tenant assignment, and peripheral policies"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Action 3: Android & Wi-Fi Settings -->
    <LinearLayout
        android:id="@+id/btnSecurityWifiSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_flat_item"
        android:backgroundTint="#F8FAFC"
        android:orientation="vertical"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wi-Fi and Network Settings"
            android:textColor="@color/nexus_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure wireless connectivity, APN, and hardware scanner profiles"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Action 4: Reboot Device -->
    <LinearLayout
        android:id="@+id/btnSecurityReboot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_flat_item"
        android:backgroundTint="#FEE2E2"
        android:orientation="vertical"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reboot Device"
            android:textColor="@color/nexus_red"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trigger clean hardware reboot via Device Owner API"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btnSecurityCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/nexus_surface_subtle"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="@color/nexus_text_secondary"
        android:textSize="14sp" />

</LinearLayout>
