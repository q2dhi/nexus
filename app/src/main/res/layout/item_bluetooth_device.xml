<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_neomorph_card">

    <ImageView
        android:id="@+id/ivBtIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_neomorph_pill"
        android:backgroundTint="#EFF6FF"
        android:padding="7dp"
        android:src="@drawable/ic_settings_bluetooth"
        app:tint="#2563EB"
        android:contentDescription="Bluetooth Device" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBtDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bluetooth Device Name"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBtDeviceAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:11:22:33:44:55 • مقترن"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBtPairStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_neomorph_pill"
        android:backgroundTint="#F1F5F9"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="مقترن"
        android:textColor="#475569"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
