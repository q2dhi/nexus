<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_neomorph_dialog"
    android:orientation="vertical"
    android:padding="26dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إعدادات الربط المركزي بالسيرفر"
        android:textColor="@color/nexus_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server Sync &amp; Company Setup"
        android:textColor="@color/nexus_text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="عنوان سيرفر الويب (Web Admin URL)"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:textColor="@color/nexus_text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="كود الشركة (Company Code - مثال: 1212)"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogCompanyCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:textColor="@color/nexus_text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="اسم / وسم الجهاز (Device Name)"
        android:layout_marginBottom="22dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogDeviceTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textDirection="locale"
            android:textColor="@color/nexus_text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelServerSettings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_neomorph_button"
            android:paddingHorizontal="16dp"
            android:text="إلغاء"
            android:textAllCaps="false"
            android:textColor="@color/nexus_text_secondary"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnSaveServerSettings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_neomorph_button_primary"
            android:paddingHorizontal="18dp"
            android:text="حفظ ومزامنة فورية"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
