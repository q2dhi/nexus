<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnKioskSettingsBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_neomorph_pill"
            android:backgroundTint="#F1F5F9"
            android:src="@drawable/ic_nav_back"
            app:tint="#1E293B"
            android:contentDescription="رجوع" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_neomorph_pill"
            android:backgroundTint="#EFF6FF"
            android:padding="8dp"
            android:src="@drawable/ic_nav_settings"
            app:tint="#1D4ED8"
            android:contentDescription="Settings Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إعدادات الجهاز"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JIB MobiControl Enterprise Kiosk"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neomorph_pill"
            android:backgroundTint="#DBEAFE"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="وضع الكشك"
            android:textColor="#1D4ED8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Settings Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============================================== -->
            <!-- 1. WI-FI SECTION -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neomorph_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Wi-Fi Header & Master Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_neomorph_pill"
                        android:backgroundTint="#EFF6FF"
                        android:padding="8dp"
                        android:src="@drawable/ic_settings_wifi"
                        app:tint="#2563EB"
                        android:contentDescription="Wi-Fi Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="الواي فاي (Wi-Fi)"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSettingsWifiStateSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="تفعيل أو تعطيل الاتصال اللاسلكي"
                            android:textColor="#64748B"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSettingsWifi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="#2563EB"
                        app:trackTint="#93C5FD" />
                </LinearLayout>

                <!-- Currently Connected Network Card -->
                <LinearLayout
                    android:id="@+id/cardConnectedWifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_neomorph_pill"
                    android:backgroundTint="#F0FDF4"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginTop="14dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_settings_wifi"
                        app:tint="#16A34A"
                        android:contentDescription="Connected" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvConnectedWifiSsid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="متصل: JIB-Corporate-5G"
                            android:textColor="#166534"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvConnectedWifiDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IP: 192.168.1.50 • إشارة ممتازة"
                            android:textColor="#15803D"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnDisconnectWifi"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="قطع الاتصال"
                        android:textColor="#DC2626"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Available Networks Header & Scan Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="الشبكات المتوفرة في النطاق"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnScanWifi"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_neomorph_pill"
                        android:backgroundTint="#EFF6FF"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="🔄 تحديث الشبكات"
                        android:textColor="#2563EB"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Scanning Progress -->
                <ProgressBar
                    android:id="@+id/pbWifiScanning"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- Networks RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvWifiNetworks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/tvEmptyWifiNetworks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="اضغط 'تحديث الشبكات' للبحث عن الشبكات القريبة"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- 2. BLUETOOTH SECTION -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neomorph_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Bluetooth Header & Master Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_neomorph_pill"
                        android:backgroundTint="#EFF6FF"
                        android:padding="8dp"
                        android:src="@drawable/ic_settings_bluetooth"
                        app:tint="#2563EB"
                        android:contentDescription="Bluetooth Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="البلوتوث (Bluetooth)"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSettingsBtStateSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="تفعيل أو تعطيل التوصيل اللاسلكي"
                            android:textColor="#64748B"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSettingsBt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="#2563EB"
                        app:trackTint="#93C5FD" />
                </LinearLayout>

                <!-- Bluetooth Details -->
                <TextView
                    android:id="@+id/tvSettingsBtDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="اسم هذا الجهاز: Honeywell Mobile"
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <!-- Paired Devices Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="الأجهزة المقترنة (Paired Devices)"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnScanBt"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_neomorph_pill"
                        android:backgroundTint="#EFF6FF"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="🔍 بحث عن أجهزة"
                        android:textColor="#2563EB"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Scanning Progress -->
                <ProgressBar
                    android:id="@+id/pbBtScanning"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- Paired Devices List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBtPairedDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/tvEmptyBtDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="لا توجد أجهزة بلوتوث مقترنة حالياً"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <!-- Discovered Devices List -->
                <TextView
                    android:id="@+id/tvDiscoveredHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp"
                    android:text="الأجهزة المكتشفة القريبة"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBtDiscoveredDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ============================================== -->
            <!-- 3. DISPLAY BRIGHTNESS SECTION -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neomorph_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <!-- Brightness Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_neomorph_pill"
                        android:backgroundTint="#FEF3C7"
                        android:padding="8dp"
                        android:src="@drawable/ic_settings_brightness"
                        app:tint="#D97706"
                        android:contentDescription="Brightness Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="سطوع الشاشة (Brightness)"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="التحكم في إضاءة شاشة جهاز الكشك"
                            android:textColor="#64748B"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSettingsBrightnessPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_neomorph_pill"
                        android:backgroundTint="#EFF6FF"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="75%"
                        android:textColor="#2563EB"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Brightness SeekBar -->
                <SeekBar
                    android:id="@+id/sbSettingsBrightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:max="100"
                    android:progress="75"
                    android:progressTint="#2563EB"
                    android:thumbTint="#1D4ED8" />

                <!-- Preset Quick Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="4dp">

                    <Button
                        android:id="@+id/btnBright25"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_neomorph_pill"
                        android:backgroundTint="#F1F5F9"
                        android:text="25% منخفض"
                        android:textColor="#475569"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnBright50"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_neomorph_pill"
                        android:backgroundTint="#F1F5F9"
                        android:text="50% معتدل"
                        android:textColor="#475569"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnBright75"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_neomorph_pill"
                        android:backgroundTint="#F1F5F9"
                        android:text="75% قياسي"
                        android:textColor="#475569"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnBright100"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_neomorph_pill"
                        android:backgroundTint="#F1F5F9"
                        android:text="100% أقصى"
                        android:textColor="#475569"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Auto-Brightness Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="السطوع التلقائي والتكيفي (Auto-Brightness)"
                        android:textColor="#334155"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAutoBrightness"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="#D97706"
                        app:trackTint="#FDE68A" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
