<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@color/nexus_bg_light">

    <!-- ========================================================================= -->
    <!-- STATE 1: KIOSK LAUNCHER SURFACE (Ultra-Minimalist Dedicated Home Screen)   -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:id="@+id/layoutKioskSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false"
        android:background="@color/nexus_bg_light"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- ========================================================================= -->
        <!-- ROYAL BLUE ENTERPRISE HEADER (#1E40AF)                                    -->
        <!-- ========================================================================= -->
        <LinearLayout
            android:id="@+id/layoutKioskHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="false"
            android:background="@color/nexus_royal_blue"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="36dp"
            android:paddingBottom="20dp">

            <!-- Top Row: Logo, "nexus.", and Admin Lock Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Logo Mark & Brand Text -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Logo Emblem -->
                    <ImageView
                        android:id="@+id/ivKioskLogo"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@color/nexus_royal_blue_dark"
                        android:padding="6dp"
                        android:src="@drawable/ic_nexus_logo"
                        android:contentDescription="Nexus Logo" />

                    <!-- Brand Name "nexus" -->
                    <TextView
                        android:id="@+id/tvKioskBrand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="nexus"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02" />

                    <!-- Royal/Sky Blue Dot "." -->
                    <TextView
                        android:id="@+id/tvKioskBrandDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="."
                        android:textColor="#93C5FD"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvKioskBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="#2563EB"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="KIOSK"
                        android:textColor="#DBEAFE"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Row in Header: Real-Time Time and Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Large Crisp Time Display -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvKioskClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:00"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvKioskAmPm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="PM"
                        android:textColor="#BFDBFE"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Date and Company Subtitle -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvKioskDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الخميس، 4 أيلول 2026"
                        android:textColor="#E0E7FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvKioskSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Nexus Dedicated Workspace"
                        android:textColor="#93C5FD"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Kiosk Applications Content Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:letterSpacing="0.06"
                android:text="AUTHORIZED APPLICATIONS"
                android:textColor="@color/nexus_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvKioskApps"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false" />

            <!-- Minimalist Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="Protected by Nexus Enterprise Firmware"
                android:textColor="@color/nexus_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ========================================================================= -->
        <!-- ON-SCREEN ENTERPRISE NAVIGATION BAR (Always Visible at Bottom of Screen)  -->
        <!-- ========================================================================= -->
        <LinearLayout
            android:id="@+id/layoutKioskBottomBar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <!-- 1. Back Navigation Button -->
            <LinearLayout
                android:id="@+id/btnKioskNavBack"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_back"
                    app:tint="#334155"
                    android:contentDescription="رجوع" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="رجوع"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Home Navigation Button -->
            <LinearLayout
                android:id="@+id/btnKioskNavHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_home"
                    app:tint="#1E40AF"
                    android:contentDescription="الرئيسية" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="الرئيسية"
                    android:textColor="#1E40AF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Admin Console / Security Button -->
            <LinearLayout
                android:id="@+id/btnKioskNavAdmin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_nav_admin"
                    app:tint="#334155"
                    android:contentDescription="المسؤول" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="المسؤول"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ========================================================================= -->
    <!-- STATE 2: ADMIN CONSOLE (Light Minimalist - Cardless Design)               -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:id="@+id/layoutAdminConsole"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/nexus_bg_light"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nexus Enterprise"
                    android:textColor="@color/nexus_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Administrator Workspace Console"
                    android:textColor="@color/nexus_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnEnterKioskMode"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="@color/nexus_blue"
                android:paddingHorizontal="16dp"
                android:text="Launch Kiosk"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/nexus_divider" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Status Pills Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvDeviceOwnerBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="Device Owner: Active"
                        android:textColor="@color/nexus_green"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvHomeLauncherBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="Home App: Set as Default"
                        android:textColor="@color/nexus_amber"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvCloudStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="Cloud: Ready"
                        android:textColor="@color/nexus_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Dedicated Button to Set as Default Home -->
                <Button
                    android:id="@+id/btnSetDefaultHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/nexus_surface_subtle"
                    android:text="Set Nexus as Default Home App (Permanent Lock)"
                    android:textAllCaps="false"
                    android:textColor="@color/nexus_text_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Dedicated Button to Activate Device Admin for Remote Lock -->
                <Button
                    android:id="@+id/btnActivateAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/nexus_surface_subtle"
                    android:text="Activate Device Admin (Required for Remote Screen Lock)"
                    android:textAllCaps="false"
                    android:textColor="@color/nexus_blue"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <!-- SECTION 1: KIOSK APPLICATION WHITELIST -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="28dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Managed Kiosk Applications"
                                android:textColor="@color/nexus_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Configured and managed remotely from Web Admin Console."
                                android:textColor="@color/nexus_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnSaveWhitelist"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="@color/nexus_accent"
                            android:paddingHorizontal="12dp"
                            android:text="Save Selection"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvWhitelistSelector"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:nestedScrollingEnabled="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/nexus_divider"
                    android:layout_marginBottom="24dp" />

                <!-- SECTION 2: WEB ADMIN CLOUD CONNECTION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Web Admin Remote Controller"
                        android:textColor="@color/nexus_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connect device to central Web Admin for remote locking, wiping, and OTA app updates."
                        android:textColor="@color/nexus_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Web Admin Server URL (e.g., http://192.168.1.50:3000)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etServerUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:textColor="@color/nexus_text_primary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Device Identifier Name"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDeviceTag"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/nexus_text_primary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Company Code (e.g., 1212)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCompanyCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:textColor="@color/nexus_text_primary"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnConnectServer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/nexus_surface_subtle"
                        android:text="Save &amp; Sync with Web Admin"
                        android:textAllCaps="false"
                        android:textColor="@color/nexus_text_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/nexus_divider"
                    android:layout_marginBottom="24dp" />

                <!-- SECTION 3: SYSTEM SECURITY CONTROLS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Security Controls"
                        android:textColor="@color/nexus_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Camera Toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hardware Camera"
                                android:textColor="@color/nexus_text_primary"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Allow or disable physical camera sensor access"
                                android:textColor="@color/nexus_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchCameraAdmin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <!-- Screen Capture Toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Screen Capture &amp; Screenshots"
                                android:textColor="@color/nexus_text_primary"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Block screenshots and screen recordings"
                                android:textColor="@color/nexus_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchScreenCaptureAdmin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <!-- Cellular Only / Disable Wi-Fi Toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mobile Data Only (Disable Wi-Fi)"
                                android:textColor="@color/nexus_text_primary"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Turn off Wi-Fi and enforce cellular 4G/5G data only"
                                android:textColor="@color/nexus_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchCellularOnlyAdmin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>

                    <!-- Change Admin Password -->
                    <Button
                        android:id="@+id/btnChangePassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/nexus_surface_subtle"
                        android:text="Change Admin Maintenance Password"
                        android:textAllCaps="false"
                        android:textColor="@color/nexus_text_primary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Admin Console Bottom Return Bar -->
        <LinearLayout
            android:id="@+id/layoutAdminBottomBar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:id="@+id/btnAdminNavHome"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_home"
                    app:tint="#1E40AF"
                    android:contentDescription="العودة للكشك" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="العودة للكشك (Kiosk)"
                    android:textColor="#1E40AF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAdminNavExitAndroid"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginStart="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_admin"
                    app:tint="#DC2626"
                    android:contentDescription="خروج لنظام أندرويد" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="الخروج للأندرويد (Exit OS)"
                    android:textColor="#DC2626"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ========================================================================= -->
    <!-- STATE 3: OFFICIAL LOADING SCREEN (شاشة التحميل - Approved Nexus Branding) -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:id="@+id/layoutLoadingScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <!-- Approved Emblem (Royal Blue Solid Square with White Layers) -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@color/nexus_royal_blue"
            android:padding="22dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_nexus_logo"
                android:contentDescription="Nexus Approved Logo" />
        </FrameLayout>

        <!-- Brand Name: nexus (Black) + . (Royal Blue) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="nexus"
                android:textColor="#000000"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="."
                android:textColor="@color/nexus_royal_blue"
                android:textSize="36sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="منظومة إدارة الأجهزة الذكية وبيئة الكشك المخصصة"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

        <!-- Elegant Indeterminate Progress Bar -->
        <ProgressBar
            android:id="@+id/pbLoadingApp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="@color/nexus_royal_blue"
            android:layout_marginTop="40dp" />

        <!-- Loading Status Label -->
        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="جاري تشغيل النظام والتحقق من الأمان..."
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="14dp" />

    </LinearLayout>

</FrameLayout>
