<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:background="@drawable/bg_neomorph_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="26dp">

    <!-- Message Icon -->
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_neomorph_pill"
        android:backgroundTint="#EFF6FF"
        android:padding="14dp"
        android:src="@drawable/ic_shield"
        app:tint="#2563EB"
        android:contentDescription="Message Icon" />

    <TextView
        android:id="@+id/tvMsgHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="إشعار إداري عاجل"
        android:textColor="#2563EB"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMsgTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="رسالة من إدارة النظام"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMsgBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_neomorph_card"
        android:lineSpacingExtra="4dp"
        android:padding="16dp"
        android:text="محتوى الرسالة"
        android:textColor="#334155"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnMsgOk"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_neomorph_button_primary"
        android:text="حسناً، فهمت ذلك"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
